# EkoService Backend - Production Environment
# Copy ke backend/.env di server, lalu isi nilai aslinya.

NODE_ENV=production
PORT=3000
APP_NAME=EkoService
APP_URL=https://api.domain-kamu.com
APP_FRONTEND_URL=https://domain-kamu.com

# Database container internal Docker Compose.
# Ganti user/password sesuai nilai POSTGRES_USER dan POSTGRES_PASSWORD di environment server.
DATABASE_URL=postgresql://eko_service:GANTI_PASSWORD_POSTGRES@postgres:5432/eko_service

# Redis container internal Docker Compose.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GANTI_PASSWORD_REDIS
REDIS_DB=0

# Generate:
# openssl rand -hex 64
JWT_SECRET=GANTI_DENGAN_RANDOM_HEX_64_BYTE
JWT_REFRESH_SECRET=GANTI_DENGAN_RANDOM_HEX_64_BYTE_LAIN

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Generate:
# openssl rand -hex 32
# Nilai ini juga harus dipakai saat build frontend sebagai VITE_API_KEY.
API_KEY=GANTI_DENGAN_RANDOM_HEX_32_BYTE

# Isi domain frontend production. Pisahkan dengan koma kalau lebih dari satu.
ALLOWED_ORIGINS=https://domain-kamu.com,https://www.domain-kamu.com

# SMTP boleh dikosongkan kalau fitur email belum dipakai.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EkoService <noreply@domain-kamu.com>

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

ENABLE_RATE_LIMIT=true
ENABLE_AUDIT_LOG=true

LOG_LEVEL=info
LOG_PRETTY=false
