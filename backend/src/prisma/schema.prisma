// ============================================================
// EkoService - Prisma Schema
// PostgreSQL 16 + Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN_OPERASIONAL
  CUSTOMER
  TEKNISI
  FINANCE
  WAREHOUSE
}

enum StatusBooking {
  BOOKING_DIBUAT
  MENUNGGU_PENUGASAN
  TEKNISI_DITUGASKAN
  TEKNISI_MENUJU_LOKASI
  TEKNISI_TIBA
  DIAGNOSIS_DIMULAI
  PENAWARAN_DIBUAT
  MENUNGGU_PERSETUJUAN_PELANGGAN
  DISETUJUI_PELANGGAN
  SERVIS_DIMULAI
  SERVIS_SELESAI
  MENUNGGU_PEMBAYARAN
  PEMBAYARAN_DITERIMA
  SELESAI
  DIBATALKAN_PELANGGAN
  DIBATALKAN_ADMIN
  DIBATALKAN_SISTEM
}

enum StatusPembayaran {
  BELUM_DIBAYAR
  MENUNGGU_PEMBAYARAN
  DIBAYAR_SEBAGIAN
  LUNAS
  GAGAL
  DIREFUND
}

enum JenisTransaksi {
  MASUK
  KELUAR
}

enum KategoriLayanan {
  SERVICE_AC
  SERVICE_KULKAS
  SERVICE_MESIN_CUCI
  SERVICE_CHILLER
  SERVICE_SHOWCASE
  SERVICE_TV
}

enum KategoriSparepart {
  KULKAS
  AC
  MESIN_CUCI
  SHOWCASE
  TV
}

// ──────────────────────────────────────────────────────────
// USER (all roles)
// ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  nama      String
  email     String   @unique
  password  String   // hashed with argon2
  noTelp    String?
  role      Role     @default(CUSTOMER)
  aktif     Boolean  @default(true)
  dibuatDi  DateTime @default(now())
  diupdateDi DateTime @updatedAt

  // Relations
  bookingsDibuat      Booking[]         @relation("BookingDibuatOleh")
  bookingsDitugaskan  Booking[]         @relation("BookingDitugaskan")
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
  @@index([aktif])
  @@map("users")
}

// ──────────────────────────────────────────────────────────
// BOOKING
// ──────────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(uuid())
  idTampilan      String        @unique // BK-XXXXXX format

  // Customer info
  namaPelanggan   String
  noTelpPelanggan String
  alamat          String
  kategori        KategoriLayanan

  // Service info
  tglBooking      DateTime
  tglServis       DateTime?
  catatan         String?
  diagnosis       String?

  // Status & assignment
  status          StatusBooking @default(BOOKING_DIBUAT)
  teknisiId       String?
  dibuatOlehId    String

  // Financial
 estimasiBiaya    Decimal?      @db.Decimal(12, 0)
  biayaAkhir       Decimal?      @db.Decimal(12, 0)
  statusPembayaran StatusPembayaran @default(BELUM_DIBAYAR)

  // Timestamps
  dibuatDi        DateTime      @default(now())
  diupdateDi      DateTime      @updatedAt
  selesaiDi       DateTime?

  // Relations
  dibuatOleh      User          @relation("BookingDibuatOleh", fields: [dibuatOlehId], references: [id])
  teknisi         User?         @relation("BookingDitugaskan", fields: [teknisiId], references: [id])
  transaksi       Transaksi[]
  fotoServis      FotoServis[]
  detailServis    DetailServis[]

  @@index([idTampilan])
  @@index([status])
  @@index([teknisiId])
  @@index([dibuatOlehId])
  @@index([kategori])
  @@index([tglServis])
  @@index([tglBooking])
  @@index([statusPembayaran])
  @@index([dibuatDi])
  @@map("bookings")
}

// ──────────────────────────────────────────────────────────
// TRANSAKSI (Keuangan)
// ──────────────────────────────────────────────────────────

model Transaksi {
  id          String         @id @default(uuid())
  idTampilan  String         @unique // TX-XXXXXX format

  deskripsi   String
  jenis       JenisTransaksi
  nominal     Decimal        @db.Decimal(12, 0)
  metodeBayar String?        // CASH, TRANSFER, QRIS

  // Optional booking link
  bookingId   String?

  // Timestamps
  dibuatDi    DateTime       @default(now())
  diupdateDi  DateTime       @updatedAt

  // Relations
  booking     Booking?        @relation(fields: [bookingId], references: [id])

  @@index([idTampilan])
  @@index([jenis])
  @@index([bookingId])
  @@index([dibuatDi])
  @@map("transaksis")
}

// ──────────────────────────────────────────────────────────
// SPAREPART (Inventory)
// ──────────────────────────────────────────────────────────

model Sparepart {
  id          String          @id @default(uuid())
  idTampilan  String          @unique // SP-XXXXXX format

  nama        String
  kategori    KategoriSparepart
  stok        Int             @default(0)
  stokMinimal Int             @default(5)
  satuan      String          @default("pcs")
  hargaBeli   Decimal?        @db.Decimal(12, 0)

  // Timestamps
  dibuatDi    DateTime        @default(now())
  diupdateDi  DateTime        @updatedAt

  // Relations
  detailServis DetailServis[]

  @@index([idTampilan])
  @@index([kategori])
  @@index([stok])
  @@map("spareparts")
}

// ──────────────────────────────────────────────────────────
// FOTO SERVIS
// ──────────────────────────────────────────────────────────

model FotoServis {
  id        String   @id @default(uuid())
  url       String
  jenis     String   // "diagnosis" | "progres" | "selesai"
  caption   String?
  bookingId String

  dibuatDi  DateTime @default(now())

  // Relations
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("foto_servis")
}

// ──────────────────────────────────────────────────────────
// DETAIL SERVIS (sparepart used in a booking)
// ──────────────────────────────────────────────────────────

model DetailServis {
  id          String    @id @default(uuid())
  jumlah      Int       @default(1)
  hargaSatuan Decimal   @db.Decimal(12, 0)
  bookingId   String
  sparepartId String

  sparepart   Sparepart @relation(fields: [sparepartId], references: [id])
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([sparepartId])
  @@map("detail_servis")
}

// ──────────────────────────────────────────────────────────
// REFRESH TOKEN (hashed, stored in DB)
// ──────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique // hashed version of the token
  family    String   // for rotation detection
  userId    String
  expiresDi DateTime
  dibuatDi  DateTime @default(now())
  diupdateDi DateTime @updatedAt
  diRevoke  Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([family])
  @@index([expiresDi])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────
// API KEY (hashed, stored in DB)
// ──────────────────────────────────────────────────────────

model ApiKey {
  id          String   @id @default(uuid())
  nama        String   // e.g., "Frontend Production"
  tokenHash   String   @unique // hashed version
  permissions String[] // e.g., ["read:booking", "write:booking"]
  aktif       Boolean  @default(true)
  batasRate   Int?     // req/menit, null = unlimited
  expiresDi   DateTime?
  dibuatDi    DateTime @default(now())
  diupdateDi  DateTime @updatedAt

  auditLogs   AuditLog[]

  @@index([tokenHash])
  @@index([aktif])
  @@map("api_keys")
}

// ──────────────────────────────────────────────────────────
// AUDIT LOG (immutable, for compliance & security)
// ──────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  apiKeyId    String?
  action      String    // e.g., "booking.create", "user.login"
  resource    String    // e.g., "booking", "user"
  resourceId  String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  requestId   String    // X-Request-ID from header
  dibuatDi    DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id])
  apiKey      ApiKey?   @relation(fields: [apiKeyId], references: [id])

  @@index([userId])
  @@index([apiKeyId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([requestId])
  @@index([dibuatDi])
  @@map("audit_logs")
}