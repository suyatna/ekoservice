// EkoService - DB diagram untuk dbdiagram.io
// Scope: data yang benar-benar tampil/diedit di frontend sekarang.

Project ekoservice {
  database_type: "PostgreSQL"
}

Enum Role {
  ADMIN
}

Enum StatusBookingGroup {
  MENUNGGU
  SERVIS
  SELESAI
  DIBATALKAN
}

Enum KategoriLayanan {
  SERVICE_AC
  SERVICE_KULKAS
  SERVICE_MESIN_CUCI
  SERVICE_CHILLER
  SERVICE_SHOWCASE
  SERVICE_TV
}

Enum KategoriSparepart {
  KULKAS
  AC
  MESIN_CUCI
  SHOWCASE
  TV
}

Enum JenisTransaksi {
  MASUK
  KELUAR
}

Table users {
  id varchar [pk]
  nama varchar [not null]
  email varchar [not null, unique]
  password varchar [not null]
  role Role [not null, default: "ADMIN"]
  aktif boolean [not null, default: true]

  indexes {
    email
    role
    aktif
  }
}

Table bookings {
  id varchar [pk]
  idTampilan varchar [not null, unique]
  namaPelanggan varchar [not null]
  noTelpPelanggan varchar [not null]
  kategori KategoriLayanan [not null]
  tglBooking timestamp [not null]
  status StatusBookingGroup [not null, default: "MENUNGGU"]
  dibuatOlehId varchar [not null]

  indexes {
    idTampilan
    namaPelanggan
    status
    kategori
    tglBooking
  }
}

Table spareparts {
  id varchar [pk]
  idTampilan varchar [not null, unique]
  nama varchar [not null]
  kategori KategoriSparepart [not null]
  stok int [not null, default: 0]
  satuan varchar [not null, default: "pcs"]

  indexes {
    idTampilan
    nama
    kategori
    stok
  }
}

Table transaksis {
  id varchar [pk]
  idTampilan varchar [not null, unique]
  dibuatDi timestamp [not null]
  deskripsi varchar [not null]
  jenis JenisTransaksi [not null]
  nominal decimal(12,0) [not null]

  indexes {
    idTampilan
    dibuatDi
    deskripsi
    jenis
  }
}

Ref: bookings.dibuatOlehId > users.id
