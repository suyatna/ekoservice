# EkoService Docker Compose Environment
# Copy ke .env di root project pada server.

POSTGRES_USER=eko_service
POSTGRES_PASSWORD=GANTI_PASSWORD_POSTGRES
REDIS_PASSWORD=GANTI_PASSWORD_REDIS

# Harus sama dengan API_KEY di backend/.env.
API_KEY=GANTI_DENGAN_RANDOM_HEX_32_BYTE

# Opsional. Frontend Docker build memakai /api sebagai default.
APP_API_URL=https://domain-kamu.com/api
