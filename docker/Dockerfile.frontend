# ============================================================
# Dockerfile - Frontend (Vite + React SPA)
# Multi-stage build: builder → nginx
# ============================================================

# ── Builder Stage ────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy frontend source
COPY frontend/package*.json ./
RUN npm ci --frozen-lockfile

COPY frontend/ ./

# Build arguments untuk env vars
ARG VITE_API_BASE_URL=http://localhost:3000
ARG VITE_API_KEY=dev_api_key

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_KEY=$VITE_API_KEY

RUN npm run build

# ── Nginx Stage ─────────────────────────────────────────
FROM nginx:alpine AS runner

# Remove default nginx config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy nginx config
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY frontend/dist /usr/share/nginx/html

# Gzip compression & caching
RUN find /usr/share/nginx/html -type f \( -name "*.js" -o -name "*.css" -o -name "*.html" \) \
    -exec gzip -9 {} \; && \
    mv /usr/share/nginx/html{,.gz} || true

# Security: non-root
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]